<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions at all. HubidubiCash never goes online: no account, no
         cloud, nothing sent anywhere. A backup leaves the phone only as a file
         the person saves, sealed with their password. -->

    <application
        android:name=".HubidubiCashApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HubidubiCash">

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A spending straight from the home screen: the app's own sheets over
             whatever is there, the app itself never opened. The launcher
             shortcut opens it too, so it is exported. -->
        <activity
            android:name=".capture.QuickSpendActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HubidubiCash.Translucent" />

        <!-- Asks which kind a kind widget is for, when it is placed. -->
        <activity
            android:name=".capture.KindWidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HubidubiCash.Translucent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- "New spending": asks the kind, then the amount. -->
        <receiver
            android:name=".capture.NewSpendingWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spending_widget_info" />
        </receiver>

        <!-- One kind: straight to the amount. -->
        <receiver
            android:name=".capture.KindWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kind_widget_info" />
        </receiver>
    </application>
</manifest>
