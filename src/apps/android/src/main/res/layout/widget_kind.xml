<?xml version="1.0" encoding="utf-8"?>
<!-- One cell holding the kind's round icon, drawn when the widget is placed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_kind"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_kind_icon"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="@string/kind_widget_label"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_kind_round" />
</FrameLayout>
