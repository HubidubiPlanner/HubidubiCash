<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window under Compose: Ivory's paper, so nothing flashes white or black at start. -->
    <style name="Theme.HubidubiCash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The home screen shows through around the quick sheets. -->
    <style name="Theme.HubidubiCash.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
